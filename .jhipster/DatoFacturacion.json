{
  "annotations": {
    "changelogDate": "20231210222627"
  },
  "applications": ["commerceApp"],
  "documentation": "Datos para emitir factura (RUC del cliente o de su empresa)",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "ruc",
      "fieldType": "String",
      "fieldValidateRules": ["required", "pattern"],
      "fieldValidateRulesPattern": "^(10|20)[0-9]{9}$"
    },
    {
      "fieldName": "razonSocial",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "fieldName": "direccionFiscal",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "250"
    },
    {
      "fieldName": "predeterminado",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "activo",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "createdBy",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "createdDate",
      "fieldType": "Instant"
    },
    {
      "fieldName": "lastModifiedBy",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "lastModifiedDate",
      "fieldType": "Instant"
    }
  ],
  "name": "DatoFacturacion",
  "relationships": [
    {
      "otherEntityField": "codigo",
      "otherEntityName": "cliente",
      "otherEntityRelationshipName": "datosFacturacion",
      "relationshipName": "cliente",
      "relationshipSide": "right",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
  "service": "serviceImpl"
}
